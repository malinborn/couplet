#!/usr/bin/env bash
# `mdmini` is couplet's former name. It stays a working command — people have
# it in MCP configs (`mdmini -- mdmini mcp`), scripts and $EDITOR — so this
# only hands over to `couplet`, arguments and stdin untouched.
#
# The one thing it adds: once, and only to a human at a terminal, a line on
# stderr saying the command has a new name. Never on stdout — every verb
# answers in JSON there and `mdmini mcp` speaks JSON-RPC over it — and never
# for an agent (CLAUDECODE set). The "once" marker lives under Caches, NOT in
# ~/Library/Application Support/couplet: a CLI write there before the app's
# first launch would make the data migration see a populated directory and
# leave md-mini's data behind.

# Beside this file first: inside the bundle (and in a Homebrew bin dir that
# links both names) `couplet` sits next to `mdmini`.
target="$(dirname "$0")/couplet"
if [ ! -x "$target" ]; then
  target="/Applications/couplet.app/Contents/Resources/bin/couplet"
fi

if [ "$(basename "$0")" = "mdmini" ] && [ -t 2 ] && [ -z "${CLAUDECODE:-}" ]; then
  notice_dir="$HOME/Library/Caches/couplet"
  notice="$notice_dir/mdmini-renamed-notice"
  # Record first, print only if that worked: an unwritable Caches must not
  # turn "once" into "every time". The group puts 2>/dev/null around the
  # `>` itself — a trailing 2>/dev/null is applied after `>` has failed.
  if [ ! -e "$notice" ] && { mkdir -p "$notice_dir" && : > "$notice"; } 2>/dev/null; then
    echo "mdmini is now couplet. This command keeps working; \`couplet\` is the new name." >&2
  fi
fi

exec "$target" "$@"
